@startuml clases02_app
!include estilo.iuml
title Diagrama de clases – Aplicación móvil (taxímetro offline-first)

enum EstadoTaximetro {
  libre
  ocupado
  aPagar
}

enum Superficie {
  asfalto
  tierra
  empedrado
}

enum ModoTarifa {
  s
  d
}

enum Sugerencia {
  ninguna
  caminoIrregular
  caminoLiso
}

enum FallaGPS {
  apagado
  sinPermiso
  bloqueado
  aproximada
  sinSenal
  + mensaje : String
}

class PantallaPrueba <<interfaz>> {
  - superficie : Superficie
  - buscandoGps : boolean
  + iniciarRastreo()
  + detenerRastreo()
  + sincronizarViajesPendientes()
  - nuevaPosicion(p : Position)
  - elegirSuperficie(s : Superficie)
  - avisarFallaGps(f : FallaGPS)
  - cobrar(viaje, taximetro, segundosFinal)
  - guardarViaje(viaje, taximetro) : int
  - recuperarViaje()
  + iniciarDemostracion()
  - avanzarDemostracion()
}

class ParametrosTopograficos {
  + costoBaseKm : double
  + consumoLitrosKm : double
  + precioCombustibleBs : double
  + factorSuperficie : double
  + factorEmpedrado : double
  + costoMinutoDetencion : double
  + bajadaBandera : double
  + valorSalto : double
  + modoTarifa : ModoTarifa
  + costoVariableKm() : double
  + {static} fromJson(json) : ParametrosTopograficos
}

class ParametrosService {
  + {static} obtener() : ParametrosTopograficos
}

class TarifaTaximetro {
  + modo : ModoTarifa
  + bajada : int
  + salto : int
  + porKm : Map<Superficie, int>
  + porHora : int
  + {static} desde(p : ParametrosTopograficos) : TarifaTaximetro
  + velocidadCruceKmh(s : Superficie) : double
}

class Taximetro {
  - estado : EstadoTaximetro
  - acumulado : int
  - saltos : int
  - segundosPorTiempo : int
  + centavos : int {readOnly}
  + ocupar(inicio : PuntoRuta)
  + registrar(p : PuntoRuta)
  + tramo(mm : int, segundos : int, s : Superficie)
  + centavosEn(segundosAhora : int) : int
  + cobrar(segundosFinal : int, s : Superficie)
  + liberar()
  + {static} desdeRuta(t : TarifaTaximetro, ruta) : Taximetro
}

class RecorridoPorSuperficie {
  + kmAsfalto() : double
  + kmTierra() : double
  + kmEmpedrado() : double
  + kmTotal() : double
  + tipo() : String
  + sumar(km : double, s : Superficie)
}

class PuntoRuta {
  + lat : double
  + lng : double
  + segundos : int
  + superficie : Superficie
  + vibracion : double
  + paraServidor() : List
}

class MotorGPS {
  + {static} obtenerUbicacionActual() : (Position?, FallaGPS?)
  + {static} obtenerFlujoUbicacion() : Stream<Position>
  + {static} enviarUltimaPosicion(lat, lng)
}

class MedidorVibracion {
  + registrar(x, y, z : double)
  + tomar() : double
}

class SugerenciaSuperficie {
  + referencia : double
  + registrar(vibracion : double, marcada : Superficie) : Sugerencia
  + descartar()
}

class ViajeEnCurso {
  + uuid : String
  + choferId : int
  + inicio : DateTime
  + guardar()
  + {static} leer() : ViajeEnCurso
  + {static} borrar()
}

class BaseDatosLocal <<SQLite>> {
  + insertarPunto(uuid, orden, p : PuntoRuta)
  + insertarViaje(viaje, ruta)
  + viajesPendientes(choferId : int) : List
  + puntosDeViaje(uuid) : List<PuntoRuta>
  + marcarSincronizado(viaje)
}

class ResultadoSincronizacion {
  + enviados : int
  + pendientes : int
  + sesionRechazada : boolean
}

class Sincronizador {
  - enCurso : boolean
  + ejecutar(token, choferId) : ResultadoSincronizacion
}

class EmpresaActual {
  + codigo : String
  + nombre : String
  + monedaSimbolo : String
  + colorPrimario : String
}

class RecorridoDemostracion {
  + {static} intervalo : int = 5
  + {static} referencia : double = 0.55
  + tramos : List<TramoDemostracion>
  + puntos : List<PuntoDemostracion>
  + duracion : int {readOnly}
  + tramoEn(segundos : int) : TramoDemostracion
}

class TramoDemostracion {
  + descripcion : String
  + superficie : Superficie
  + segundos : int
  + kmh : double
  + rumbo : double
  + vibracion : double
}

class PuntoDemostracion {
  + lat : double
  + lng : double
  + segundos : int
  + vibracion : double
  + tramo : int
}

class Sesion {
  + {static} guardar(token, chofer, empresa : EmpresaActual)
  + {static} tokenValido() : String
  + {static} choferId() : int
  + {static} cerrar()
}

PantallaPrueba --> Taximetro
PantallaPrueba --> MotorGPS
PantallaPrueba --> MedidorVibracion
PantallaPrueba --> SugerenciaSuperficie
PantallaPrueba --> ViajeEnCurso
PantallaPrueba --> BaseDatosLocal
PantallaPrueba --> Sincronizador
PantallaPrueba ..> ParametrosService
PantallaPrueba ..> Sesion
PantallaPrueba --> "0..1" RecorridoDemostracion : modo demostración
RecorridoDemostracion "1" *-- "1..*" TramoDemostracion
RecorridoDemostracion "1" *-- "1..*" PuntoDemostracion
TramoDemostracion --> Superficie

ParametrosService ..> ParametrosTopograficos : crea
TarifaTaximetro ..> ParametrosTopograficos : se construye desde
Taximetro "1" o-- "1" TarifaTaximetro
Taximetro "1" *-- "1" RecorridoPorSuperficie
Taximetro "1" *-- "1..*" PuntoRuta : ruta
Taximetro --> EstadoTaximetro
ViajeEnCurso "1" o-- "1" ParametrosTopograficos
Sincronizador ..> BaseDatosLocal
BaseDatosLocal ..> PuntoRuta
PuntoRuta --> Superficie
TarifaTaximetro --> ModoTarifa
MotorGPS ..> FallaGPS
SugerenciaSuperficie ..> Sugerencia
Sincronizador ..> ResultadoSincronizacion : devuelve
Sesion ..> EmpresaActual
@enduml
