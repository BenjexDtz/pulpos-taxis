@startuml desp02_despliegue
!include estilo.iuml

node "Teléfono del chofer\n<<dispositivo>> Android" as TEL {
  artifact "PulposTaxis-v1.6.4.apk\n(Flutter)" as APK
  database "SQLite" as SQLITE
}

cloud "ngrok\n(túnel HTTPS, dominio fijo)" as NGROK

node "PC de la central\n<<dispositivo>> Windows 11 Pro" as PC {
  node "Navegador web\n<<proceso>>" as NAV {
    artifact "Panel React" as PNAV
  }
  node "ngrok agent\n<<proceso>>" as AGENTE
  node "Node.js 22.20 <<proceso>> :3000\n----\nAPI Express\n(pulpos_backend 1.6.4, npm start)" as API
  node "Vite dev server (npm run dev)\n<<proceso>> :5173" as VITE {
    artifact "pulpos_web_admin 1.6.4\n(sin compilar)"
  }
  database "pulpos_db\nPostgreSQL 18.3 :5432" as DB
  database "pulpos_auditoria\n(usuario auditor_app)\nPostgreSQL 18.3 :5432" as AUD
}

cloud "Groq\n(LLM)" as LLM
cloud "OpenStreetMap\ny unpkg" as OSM

APK -- SQLITE
APK --> NGROK : HTTPS
NGROK --> AGENTE : túnel saliente
AGENTE --> API : HTTP :3000 (loopback)
PNAV --> VITE : HTTP :5173
PNAV --> API : HTTP :3000
PNAV --> OSM : HTTPS
API --> DB : TCP :5432
API --> AUD : TCP :5432
API --> LLM : HTTPS

note bottom of DB
  Las dos bases están en el mismo servicio
  PostgreSQL 18.3 (postgresql-x64-18, puerto 5432).
  La separación en dos servidores solo existe con Docker Compose.
end note
@enduml
