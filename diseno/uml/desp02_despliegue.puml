@startuml desp02_despliegue
!include estilo.iuml
title Diagrama de despliegue definitivo – Entorno actual (sin Docker)

node "Teléfono del chofer\n<<dispositivo>> Android" as TEL {
  artifact "PulposTaxis-v1.6.1.apk\n(Flutter)" as APK
  database "SQLite" as SQLITE
}

cloud "ngrok\n(túnel HTTPS, dominio fijo)" as NGROK

node "PC de la central\n<<dispositivo>> Windows 11 Pro" as PC {
  node "Navegador web\n<<proceso>>" as NAV {
    artifact "Panel React" as PNAV
  }
  node "ngrok agent\n<<proceso>>" as AGENTE
  node "Node.js 22.20\n<<proceso>> :3000" as NODE {
    artifact "API Express\n(pulpos_backend)" as API
  }
  node "Vite dev server\n<<proceso>> :5173" as VITE {
    artifact "pulpos_web_admin"
  }
  node "PostgreSQL 18.3\n<<servicio>> postgresql-x64-18 :5432" as PG {
    database "pulpos_db" as DB
    database "pulpos_auditoria\n(usuario auditor_app)" as AUD
  }
}

cloud "Groq\n(LLM)" as LLM
cloud "OpenStreetMap\ny unpkg" as OSM

APK -- SQLITE
APK --> NGROK : HTTPS
NGROK --> AGENTE : túnel saliente
AGENTE --> API : HTTP :3000 (loopback)
PNAV --> VITE : HTTP :5173
PNAV --> API : HTTP :3000
PNAV --> OSM : HTTPS
API --> DB : TCP :5432
API --> AUD : TCP :5432
API --> LLM : HTTPS

note bottom of PG
  Las dos bases comparten el mismo servidor PostgreSQL.
  La separación en dos servidores solo existe con Docker Compose.
end note
@enduml
