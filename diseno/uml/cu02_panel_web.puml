@startuml cu02_panel_web
!include estilo.iuml
left to right direction
title Diagrama de casos de uso – Panel web de administración

actor "Administrador\nde empresa" as Admin
actor "Gerente" as Gerente
actor "Supervisor" as Supervisor
actor "Superadministrador" as Super
actor "Modelo de lenguaje\n(LLM)" as LLM <<sistema>>

Gerente --|> Admin
Supervisor --|> Admin

rectangle "Panel web Pulpos" {
  usecase "CU-09 Iniciar sesión\ncon doble factor (TOTP)" as UC9
  usecase "Configurar segundo factor\n(QR y códigos de respaldo)" as UC9a
  usecase "CU-10 Monitorear la flota\n(central y mapa)" as UC10
  usecase "CU-11 Consultar viajes" as UC11
  usecase "Ver ruta y verificación\ndel viaje" as UC11a
  usecase "Exportar viajes" as UC11b
  usecase "CU-12 Gestionar choferes" as UC12
  usecase "CU-13 Configurar parámetros\nde tarifa" as UC13
  usecase "CU-14 Editar datos\nde la empresa" as UC14
  usecase "CU-15 Consultar informes\ny estadísticas" as UC15
  usecase "CU-16 Consultar al\nasistente de IA" as UC16
  usecase "CU-17 Consultar bitácora\nde auditoría" as UC17
  usecase "Verificar integridad\nde la bitácora" as UC17a
  usecase "CU-18 Gestionar empresas" as UC18
  usecase "CU-19 Gestionar administradores\n(restablecer segundo factor)" as UC19
}

Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17

Super --> UC9
Super --> UC17
Super --> UC18
Super --> UC19

UC9 <.. UC9a : <<extend>>
UC11 <.. UC11a : <<extend>>
UC11 <.. UC11b : <<extend>>
UC17 <.. UC17a : <<extend>>

UC16 -- LLM
@enduml
