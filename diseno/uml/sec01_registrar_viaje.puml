@startuml sec01_registrar_viaje
!include estilo.iuml
title Diagrama de secuencia – Registrar un viaje con el taxímetro (sin conexión)
autonumber

actor Chofer
participant ":PantallaPrueba" as UI
participant ":ParametrosService" as PS
participant ":MotorGPS" as GPS
participant ":ViajeEnCurso" as VC
participant ":Taximetro" as TX
participant ":MedidorVibracion" as MV
participant ":SugerenciaSuperficie" as SS
database ":BaseDatosLocal\n(SQLite)" as BD

== Al abrir la pantalla ==
UI -> PS : obtener()
PS --> UI : parámetros (servidor, caché o valores por defecto)

== Inicio del viaje ==
Chofer -> UI : iniciarRastreo()
UI --> Chofer : "BUSCANDO SEÑAL GPS..."
UI -> GPS : obtenerUbicacionActual()
alt GPS apagado, sin permiso, ubicación aproximada o sin señal en 20 s
  GPS --> UI : falla (FallaGPS)
  UI --> Chofer : aviso con el motivo y acceso a Ajustes
else posición obtenida
  GPS --> UI : posición inicial
  UI -> GPS : enviarUltimaPosicion(lat, lng)
  note right of GPS : la central ve la unidad\ndesde el primer momento
  UI -> VC : guardar(uuid, chofer, inicio, parámetros)
  UI -> BD : insertarPunto(uuid, 0, puntoInicial)
  UI -> TX : ocupar(puntoInicial)
  note right of TX : LIBRE → OCUPADO\nimporte = bajada de bandera
  UI -> GPS : obtenerFlujoUbicacion()

  loop cada posición GPS (precisión ≤ 20 m, ≤ 120 km/h)
    GPS --> UI : posición
    UI -> MV : tomar()
    MV --> UI : vibración (RMS desde el punto anterior)
    UI -> SS : registrar(vibración, superficieMarcada)
    SS --> UI : sugerencia
    opt la vibración no coincide con la superficie marcada
      UI --> Chofer : sugerir cambio de superficie
    end
    UI -> TX : registrar(punto)
    note right of TX : tramo: max(d × F × Tkm, t × Th)\nsuma saltos completos de S
    UI -> BD : insertarPunto(uuid, orden, punto)
    opt cada 10 posiciones
      GPS -> GPS : enviar posición a /api/posicion
    end
  end

  loop cada segundo
    UI -> TX : centavosEn(segundosAhora)
    TX --> UI : importe en pantalla
  end

  == Cobro ==
  Chofer -> UI : detenerRastreo()
  UI -> TX : cobrar(segundosFinal, superficie)
  note right of TX : OCUPADO → A_PAGAR
  TX --> UI : importe final
  UI -> GPS : enviarUltimaPosicion(lat, lng)
  note right of GPS : la central ve dónde terminó el viaje
  UI --> Chofer : mostrar tarifa a cobrar
  UI -> BD : insertarViaje(viaje, ruta)\nestado_sincronizacion = 0
  UI -> VC : borrar()
  opt el chofer indica cuánto habría cobrado sin taxímetro
    Chofer -> UI : monto tradicional
    UI -> BD : guardarTarifaTradicional(id, monto)
  end
  UI -> TX : liberar()
  note right of TX : A_PAGAR → LIBRE
  UI -> UI : sincronizarViajesPendientes()
end
@enduml
