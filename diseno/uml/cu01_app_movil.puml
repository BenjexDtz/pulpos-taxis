@startuml cu01_app_movil
!include estilo.iuml
left to right direction
title Diagrama de casos de uso – Aplicación móvil (taxímetro)

actor "Chofer" as Chofer

rectangle "Aplicación móvil Pulpos" {
  usecase "CU-01 Iniciar sesión\n(empresa, placa y contraseña)" as UC1
  usecase "CU-02 Registrar viaje" as UC2
  usecase "CU-03 Calcular tarifa\nen tiempo real (modo S/D)" as UC3
  usecase "Obtener parámetros\nde tarifa" as UC2a
  usecase "CU-04 Marcar superficie\n(asfalto, tierra, empedrado)" as UC4
  usecase "Sugerir superficie\npor vibración" as UC4a
  usecase "CU-05 Cobrar viaje" as UC5
  usecase "Registrar tarifa\nsin taxímetro" as UC5a
  usecase "Guardar viaje y ruta\nen el teléfono" as UC5b
  usecase "CU-06 Recuperar viaje\ninterrumpido" as UC6
  usecase "CU-08 Consultar historial\nde viajes" as UC8
  usecase "CU-07 Sincronizar viajes" as UC7
  usecase "Enviar posición\na la central" as UC9
  usecase "CU-20 Cerrar sesión\n(avisa si hay viajes\nsin sincronizar)" as UC20
}

actor "Receptor GPS" as GPS <<sistema>>
actor "Acelerómetro" as Acel <<sistema>>

Chofer --> UC1
Chofer --> UC2
Chofer --> UC4
Chofer --> UC5
Chofer --> UC6
Chofer --> UC8
Chofer --> UC7
Chofer --> UC20

UC2 ..> UC3 : <<include>>
UC2 ..> UC2a : <<include>>
UC4 <.. UC4a : <<extend>>
UC5 <.. UC5a : <<extend>>
UC5 ..> UC5b : <<include>>
UC3 ..> UC9 : <<include>>

UC3 -[hidden]- GPS
UC4a -[hidden]- Acel

UC3 -[norank]- GPS
UC4a -[norank]- Acel
@enduml
