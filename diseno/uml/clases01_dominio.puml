@startuml clases01_dominio
!include estilo.iuml

enum Rol {
  superadmin
  gerente
  supervisor
}

enum ModoTarifa {
  S
  D
}

enum Superficie {
  asfalto
  tierra
  empedrado
}

enum EstadoVerificacion {
  ok
  sin_ruta
  diferencia
  sin_verificar
}

class Empresa {
  - id : int
  - codigo : String
  - nombre : String
  - ciudad : String
  - zonaHoraria : String
  - monedaSimbolo : String
  - centroLat : decimal
  - centroLng : decimal
  - radioOperacionKm : decimal
  - altitudMsnm : int
  - colorPrimario : String
  - activo : boolean
  --
  + registrar()
  + actualizar(datos)
  + cambiarEstado(activo : boolean)
  - validar(datos) : String
}

class Administrador {
  - id : int
  - nombre : String
  - email : String
  - passwordHash : String
  - rol : Rol
  - activo : boolean
  - mfaActivo : boolean
  - mfaSecreto : String <<cifrado>>
  - mfaUltimoPaso : long
  - mfaBloqueadoHasta : Timestamp
  --
  + iniciarSesion(email, password) : Token
  + configurarTOTP() : QR
  + activarTOTP(codigo) : CodigoRespaldo[10]
  + verificarTOTP(codigo) : boolean
  + regenerarCodigos() : CodigoRespaldo[10]
  + restablecerMFA()
  - registrarFallo()
}

class CodigoRespaldo {
  - codigoHash : String <<SHA-256>>
  - usadoEn : Timestamp
  --
  + {static} generar() : String[10]
  + canjear(codigo) : boolean
  - {static} hash(codigo) : String
}

class Chofer {
  - id : int
  - nombreCompleto : String
  - placaVehiculo : String
  - passwordHash : String
  - estadoActivo : boolean
  - ultimaLat : decimal
  - ultimaLng : decimal
  - ultimaActualizacion : Timestamp
  --
  + iniciarSesion(empresa, placa, password) : Token
  + registrar()
  + actualizar(datos)
  + cambiarPassword(password)
  + activar()
  + desactivar()
  + actualizarPosicion(lat, lng)
}

class ParametrosTarifa {
  - costoBaseKm : decimal <<Cb>>
  - consumoLitrosKm : decimal <<Cl>>
  - precioCombustible : decimal <<Pc>>
  - factorSuperficie : decimal <<FR>>
  - factorEmpedrado : decimal <<FE>>
  - costoMinutoDetencion : decimal <<Ct>>
  - bajadaBandera : decimal <<B>>
  - valorSalto : decimal <<S>>
  - modoTarifa : ModoTarifa
  --
  + guardar(valores)
  + versionar() <<trigger>>
  + costoVariableKm() : decimal
  - validar(valores) : String
}

class ParametrosHistorial {
  - costoBaseKm : decimal
  - consumoLitrosKm : decimal
  - precioCombustible : decimal
  - factorSuperficie : decimal
  - factorEmpedrado : decimal
  - costoMinutoDetencion : decimal
  - bajadaBandera : decimal
  - valorSalto : decimal
  - modoTarifa : ModoTarifa
  - vigenteDesde : Timestamp
  --
  + {static} versionesDe(empresa) : ParametrosHistorial[*]
}

class Viaje {
  - idServidor : int
  - uuid : UUID
  - fechaHoraViaje : Timestamp
  - distanciaKm : decimal
  - kmAsfalto : decimal
  - kmTierra : decimal
  - kmEmpedrado : decimal
  - tiempoDetencionMin : decimal
  - tarifaCobrada : decimal
  - tipoSuperficie : String
  - parametrosAplicados
  - distanciaRutaKm : decimal
  - tarifaCalculada : decimal
  - verificacion : EstadoVerificacion
  - verificacionDetalle : String
  - vibracionReferencia : decimal
  - vibracionIrregular : decimal
  - superficieRespaldo : String
  - tarifaTradicional : decimal
  - demostracion : boolean
  --
  + sincronizar(viaje, ruta) : EstadoVerificacion
  + verificar(versiones) : EstadoVerificacion
  + calcularTarifa() : decimal
  - parametrosFueraDeVersion(versiones) : String
  - evaluarSuperficie() : String
  + {static} consultar(filtro) : Viaje[*]
  + {static} exportarCSV(filtro) : String
}

class PuntoRuta {
  - orden : int
  - lat : double
  - lng : double
  - segundos : int
  - superficie : Superficie
  - vibracion : real
  --
  + {static} leerRuta(json) : PuntoRuta[*]
  + {static} distanciaKm(a, b) : decimal
}

class EventoAuditoria <<base de auditoría>> {
  - id : long
  - ocurridoEn : Timestamp
  - actorTipo : String
  - actorId : int
  - accion : String
  - entidad : String
  - resultado : String
  - datosAntes : JSON
  - datosDespues : JSON
  - hashAnterior : String
  - hash : String <<SHA-256>>
  --
  + {static} registrar(evento)
  + {static} consultar(filtro) : EventoAuditoria[*]
  + {static} verificarCadena() : boolean
  - {static} reenviarPendientes()
}

class AnclaAuditoria {
  - eventoId : long
  - hash : String
}

Empresa "1" -- "1" ParametrosTarifa : tiene >
Empresa "1" -- "0..*" ParametrosHistorial : versiona >
Empresa "0..1" -- "0..*" Administrador : administra <
Empresa "1" -- "0..*" Chofer : emplea >
Empresa "1" -- "0..*" Viaje : registra >
Chofer "1" -- "0..*" Viaje : realiza >
Viaje "1" *-- "0..*" PuntoRuta : ruta >
Administrador "1" *-- "0..*" CodigoRespaldo
EventoAuditoria "1" -- "0..1" AnclaAuditoria : copia del hash <
EventoAuditoria "0..1" -- "1" EventoAuditoria : encadena con el anterior >

Administrador ..> Rol
ParametrosTarifa ..> ModoTarifa
ParametrosHistorial ..> ModoTarifa
PuntoRuta ..> Superficie
Viaje ..> EstadoVerificacion
@enduml
