@startuml act02_proceso_con_sistema
!include estilo.iuml
title Diagrama de actividades – Cobro del viaje con el sistema

|Chofer|
start
:Pulsar iniciar viaje;
|App móvil|
:Obtener la posición inicial (GPS);
:Guardar el viaje en curso\n(uuid, inicio, parámetros de la tarifa);
:Taxímetro: LIBRE → OCUPADO\n(bajada de bandera);
repeat
  fork
    |Chofer|
    :Marcar la superficie\n(asfalto, tierra o empedrado);
  fork again
    |App móvil|
    :Recibir posición GPS y vibración;
    if (¿Precisión ≤ 20 m y sin salto > 120 km/h?) then (sí)
      :Guardar el punto en puntos_viaje\ncon la superficie marcada;
      :Calcular el tramo:\nmodo S max(d × F × Tkm, t × Th)\nmodo D la suma;
      :Acumular saltos y actualizar el importe;
      if (¿La vibración no cuadra con lo marcado?) then (sí)
        :Sugerir cambiar la superficie\n(nunca la cambia sola);
      endif
    else (no)
      :Descartar la posición;
    endif
  end fork
  |Chofer|
repeat while (¿Llegó al destino?) is (no) not (sí)
:Pulsar cobrar;
|App móvil|
:Cerrar el último tramo con la hora final;
:Taxímetro: OCUPADO → A_PAGAR\n(importe congelado);
:Guardar el viaje en SQLite\n(estado_sincronizacion = 0);
|Chofer|
:Cobrar al pasajero el importe del taxímetro;
if (¿Registra cuánto habría cobrado de palabra?) then (sí)
  :Ingresar la tarifa sin taxímetro;
  |App móvil|
  :Guardar tarifa_tradicional;
else (no)
endif
|App móvil|
:Taxímetro: A_PAGAR → LIBRE;
if (¿Hay conexión?) then (sí)
  :Enviar el viaje y su ruta\na /api/viajes/sincronizar;
  |Servidor|
  :Validar token, tarifa, detención y fecha;
  :Verificar: parámetros de alguna versión,\nruta medida con Haversine,\ntarifa recalculada con el taxímetro;
  :Evaluar la superficie por vibración;
  :Guardar el viaje con su verificación\n(ok | diferencia | sin_ruta | sin_verificar);
  :Auditar viaje.sincronizar;
  |App móvil|
  :Marcar sincronizado\ny borrar la ruta del teléfono;
else (no)
  :Dejar el viaje pendiente\n(reintento cada 2 min o al abrir la app);
endif
stop
@enduml
