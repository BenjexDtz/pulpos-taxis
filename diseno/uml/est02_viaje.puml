@startuml est02_viaje
!include estilo.iuml
hide empty description

state "Teléfono" as TELEFONO {
  state EN_CURSO
  EN_CURSO : viaje en curso y sus puntos
  EN_CURSO : guardados en el teléfono
  state PENDIENTE
  PENDIENTE : marcado como no sincronizado
  PENDIENTE : registrar tarifa sin taxímetro /
  PENDIENTE : guardar el monto que se habría cobrado
  PENDIENTE : sin conexión, datos rechazados o error de autenticación /
  PENDIENTE : reintentar más tarde
  state SINCRONIZADO
  SINCRONIZADO : marcado como sincronizado
  SINCRONIZADO : ruta borrada del teléfono

  [*] --> EN_CURSO : iniciar viaje
  EN_CURSO --> PENDIENTE : cobrar / guardar el viaje
  PENDIENTE --> SINCRONIZADO : el servidor lo registra\no ya lo tenía registrado
  SINCRONIZADO --> [*]
}

state "Servidor (verificación)" as SERVIDOR {
  state verificar <<choice>>
  state OK
  OK : ruta y tarifa cuadran
  state DIFERENCIA
  DIFERENCIA : tarifa, km, parámetros o fecha
  DIFERENCIA : no cuadran (no se rechaza)
  state SIN_RUTA
  SIN_RUTA : llegó sin ruta
  state SIN_VERIFICAR
  SIN_VERIFICAR : faltan parámetros
  SIN_VERIFICAR : para recalcular

  [*] --> verificar
  verificar --> OK
  verificar --> DIFERENCIA
  verificar --> SIN_RUTA
  verificar --> SIN_VERIFICAR
}

PENDIENTE --> SERVIDOR : enviar el viaje y su ruta
@enduml
