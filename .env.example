# ═══════════════════════════════════════════════════════════════════════════════
# Radio Taxis Pulpos — Variables de Entorno
# Copiar este archivo como ".env"
# ═══════════════════════════════════════════════════════════════════════════════

DB_USER=pulpos
DB_PASSWORD=pulpos2026
DB_HOST=db
DB_PORT=5432
DB_NAME=pulpos_db

JWT_SECRET=se_modificara_en_produccion
# Clave para cifrar los secretos TOTP del segundo factor. Si falta se deriva de JWT_SECRET.
# Cambiarla invalida los segundos factores ya configurados (habría que restablecerlos).
MFA_CLAVE=se_modificara_en_produccion

# Orígenes del navegador permitidos por CORS (panel web), separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Proxy de confianza para leer la IP real (límite de intentos de login).
# Por defecto 'loopback': correcto con ngrok corriendo en la misma máquina.
# TRUST_PROXY=loopback

ADMIN_USER=admin@pulpos.bo
ADMIN_PASSWORD=PulposAdmin2026!

# Base de datos de auditoría (bitácora de solo inserción en otro servidor)
# En Docker: credenciales del administrador y del usuario de la app (auditor_app)
AUDIT_ADMIN_USER=auditoria_admin
AUDIT_ADMIN_PASSWORD=cambiar_en_produccion
AUDIT_APP_PASSWORD=cambiar_en_produccion
# Sin Docker: conexión que usa el backend
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=pulpos_auditoria
AUDIT_DB_USER=auditor_app
AUDIT_DB_PASSWORD=cambiar_en_produccion
# Cada cuántos eventos se copia el hash de la bitácora en la base principal
AUDITORIA_ANCLA_CADA=50
